# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/

# IDE / Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python egg files
*.egg
*.egg-info/
dist/
build/

# Database files
*.db
*.sqlite3

# ML / model files (optional if you want to exclude large models)
ml_models/*.pkl

# Streamlit / dashboard temporary files
.streamlit/

# Docker files
docker-compose.override.yml

# Python coverage reports
htmlcov/
.coverage

# Test cache
.pytest_cache/

# Environment variables / secrets
.env
